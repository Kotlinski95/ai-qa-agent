#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# Run full lint check
echo "🔍 Running full ESLint check..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed. Please fix all linting errors before pushing."
  exit 1
fi

# Run format check
echo "💅 Checking code formatting..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Code formatting check failed. Run 'npm run format' to fix formatting."
  exit 1
fi

# Final build check
echo "🏗️  Final build check..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Please fix the errors before pushing."
  exit 1
fi

echo "✅ All pre-push checks passed! Ready to push."