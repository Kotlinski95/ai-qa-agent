# AI QA Agent - Environment Variables Template
# Copy this file to .env for local development
# For AWS Lambda, set these as Environment Variables in the Lambda configuration

# =============================================================================
# AI Configuration (Required for OpenAI integration)
# =============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1500
OPENAI_TIMEOUT_MS=30000

# AI System Prompt
AI_SYSTEM_PROMPT="You are a helpful AI assistant that provides accurate and concise answers to questions."
AI_ENABLE_STREAMING=false

# =============================================================================
# LangGraph Configuration (Optional)
# =============================================================================

LANGGRAPH_ENABLE_TRACING=false
LANGGRAPH_MAX_ITERATIONS=10
LANGGRAPH_ENABLE_MEMORY=false

# =============================================================================
# Application Configuration
# =============================================================================

# Environment
NODE_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info

# Request/Response Logging
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_LOGGING=true

# =============================================================================
# QA Agent Settings
# =============================================================================

MAX_QUESTION_LENGTH=500
MAX_CONTEXT_LENGTH=2000
DEFAULT_QA_RESPONSE="I'm sorry, but I'm having trouble processing your question right now. Please try again."
ENABLE_CONTEXT_ENHANCEMENT=true

# =============================================================================
# Security Configuration
# =============================================================================

ENABLE_RATE_LIMITING=false
MAX_REQUESTS_PER_MINUTE=60
ALLOWED_ORIGINS=*

# =============================================================================
# CORS Configuration
# =============================================================================

CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS="GET, POST, OPTIONS"
CORS_ALLOW_HEADERS="Content-Type, Authorization"

# =============================================================================
# Performance Settings
# =============================================================================

ENABLE_REQUEST_VALIDATION=true
ENABLE_RESPONSE_COMPRESSION=false
ENABLE_CACHING=false
CACHE_TIMEOUT_SECONDS=300

# =============================================================================
# AWS Configuration
# =============================================================================

AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=ai-qa-agent

# =============================================================================
# Development Only (Not needed in Lambda)
# =============================================================================

# LOCAL_PORT=3000
# LOCAL_HOST=localhost
